# YANTRI .dockerignore
# Files and directories to exclude from Docker build context

# Git
.git
.gitignore
.gitattributes

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-store

# Build outputs
dist
build
*.tsbuildinfo

# Python
__pycache__
*.py[cod]
*$py.class
.pytest_cache
.coverage
htmlcov
.tox
.venv
venv
env
ENV

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Logs
logs
*.log
npm-debug.log*

# Testing
coverage
.nyc_output

# Documentation
*.md
!README.md
docs

# Configuration (secrets should be in .env, not in image)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# Data directories (mounted as volumes)
data
logs

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Misc
*.tgz
*.tar.gz
*.zip
*.bak
*.tmp
*.temp