# ═══════════════════════════════════════════════════════════════════════════
# YANTRI — complete environment template
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file to `.env`  →  cp .env.example .env
# 2. Fill in ONLY the values marked REQUIRED. Everything else has a working
#    default and can stay as-is.
# 3. `.env` is gitignored. Never commit real secrets. On Render, set these in
#    the dashboard instead — render.yaml already declares the server-side ones.
#
# Quick start: you only need GEMINI_API_KEY to run locally — set it here, or
# paste it in the in-app onboarding (the server checks env first, then the
# UI-stored key, so both paths work and env wins).
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# 1. REQUIRED — Gemini (the voice brain)
# ───────────────────────────────────────────────────────────────────────────
# Every voice/text reply flows through Gemini. Without this the app boots but
# the assistant cannot think or speak.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: raise/lower to steer response length. Uncomment for verbose output.
# DEBUG=true


# ───────────────────────────────────────────────────────────────────────────
# 1b. OPTIONAL — fallback LLM providers (plain-text calls only)
# ───────────────────────────────────────────────────────────────────────────
# Background text jobs (memory consolidation, email drafting) try Gemini
# first, then Groq, then OpenCode — an outage or rate limit on one provider
# transparently falls through to the next, so the assistant keeps working.
# The Live VOICE path is Gemini-only (audio bidi protocol).
#
# Groq — free key at https://console.groq.com/keys
# GROQ_API_KEY=
# Optional model override (default qwen/qwen3.8-27b — check console for current ids)
# GROQ_MODEL=qwen/qwen3.8-27b
#
# OpenCode — key at https://opencode.ai/zen
# OpenAI-compatible gateway: https://opencode.ai/zen/v1
# NOTE: OpenCode FREE-tier keys are only usable inside the OpenCode client;
# server-side API calls need a paid key (or point OPENCODE_BASE_URL at any
# other OpenAI-compatible gateway and use its key here).
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=mimo-v2.6-flash-free
#
# Tavily — AI-powered search API for high-quality web search with summarization
# Get a key at https://tavily.com/ (free tier available)
# TAVILY_API_KEY=


# ───────────────────────────────────────────────────────────────────────────
# 2. OPTIONAL — server-native Google (Gmail / Calendar / Tasks)
# ───────────────────────────────────────────────────────────────────────────
# When these are set AND consent is granted, Google tools run inside Node and
# work WITHOUT the Python desktop agent. When blank they fall back to the agent,
# so on a desktop-only setup you can leave this entire section blank.
#
# Setup — Google Cloud Console (https://console.cloud.google.com/):
#   1. Create (or select) a project.
#   2. Enable APIs: Google Calendar API, Gmail API, Tasks API.
#   3. Credentials → Create Credentials → OAuth client ID
#      → Application type: "Web application"
#   4. Authorized redirect URI (must match EXACTLY, incl. trailing slash):
#        local:  http://localhost:3000/api/google/callback
#        deploy: https://<your-app>.onrender.com/api/google/callback
#   5. Copy the Client ID and Client secret into the two fields below.
# Then open <BASE_URL>/api/google/auth in a browser and grant consent.
#
# The key must end in .apps.googleusercontent.com and the secret usually starts
# with GOCSPX-. Placeholders below — replace with your own or leave blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override the redirect URI ONLY when auto-detection guesses wrong (reverse
# proxy, custom domain). Leave blank to auto-detect from RENDER_EXTERNAL_URL in
# production, else http://localhost:${PORT:-3000}.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Consent tokens are written to google_tokens.json in YANTRI_DATA_DIR.
# That file is gitignored. Delete it to force a fresh consent round.


# ───────────────────────────────────────────────────────────────────────────
# 3. OPTIONAL — persistent state mirror (S3-compatible)
# ───────────────────────────────────────────────────────────────────────────
# Normally all state (memories, reminders, profile, userdata, OAuth tokens) is
# stored as JSON in YANTRI_DATA_DIR. On Render's free tier the disk is EPHEMERAL
# and is wiped on every redeploy. Filling these mirrors state to object storage
# and restores it automatically at boot.
# Leave blank for local dev — everything stays on the local disk.
#
# Works with Cloudflare R2, Backblaze B2, AWS S3, MinIO.
# R2 endpoint format: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=
S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Subfolder inside the bucket, and how often to flush (milliseconds).
YANTRI_SYNC_ROOT=yantri
YANTRI_SYNC_INTERVAL_MS=300000


# ───────────────────────────────────────────────────────────────────────────
# 4. Server / network
# ───────────────────────────────────────────────────────────────────────────
# Port the Node server listens on.
PORT=3000

# Set to "production" in deployed environments. server.ts uses NODE_ENV for a
# few defaults; Render sets this for you via render.yaml.
NODE_ENV=development

# When "true", the server is treated as server-only: it never spawns or calls
# the local desktop agent, and desktop tools are rejected instantly (no
# dead-air timeouts). Voice, browser player, Google services, memory,
# reminders and all data tools keep working. This is what a web/Render
# deployment or a packaged webview app (APK) should set.
# CLOUD_MODE=true
#
# When CLOUD_MODE is false/unset: the server still works WITHOUT the Python
# agent running. Boot does not spawn it; the first desktop tool call probes
# once and auto-starts it if a suitable Python is found (desktop benefit,
# never a web/phone requirement).

# Local agent override (optional, rarely needed):
# DESKTOP_AGENT_URL=http://127.0.0.1:8765

# Render injects this automatically; it is how the OAuth redirect URI is
# auto-detected in production. You never need to set it by hand.
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Standard proxy vars — honoured by Node's fetch. Set them only if you are
# behind a corporate proxy or VPN.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ───────────────────────────────────────────────────────────────────────────
# Security: CORS & Agent Authentication
# ───────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Used by both Node server and Python agent.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Shared secret for Node ↔ Python agent authentication.
# Set a strong random string (e.g., openssl rand -hex 32).
# If set, both Node and Python must have the same value.
# AGENT_SHARED_SECRET=


# ───────────────────────────────────────────────────────────────────────────
# 5. Desktop agent (Python / FastAPI) — desktop deployments only
# ───────────────────────────────────────────────────────────────────────────
# The agent gives YANTRI real desktop control: files, terminal, screenshots,
# volume/brightness/power, clipboard, Playwright browsing, spreadsheets,
# pomodoro/focus. It runs as a separate local service and talks to Node over
# HTTP. The whole section can be ignored for a web-only deployment.
#
# Python deps are required:
#   python3 -m venv .venv
#   .venv/bin/pip install -r agent/requirements.txt      (Windows: .venv\Scripts\pip)
# On first run the server auto-detects .venv and spawns the agent itself.
YANTRI_AGENT_HOST=127.0.0.1
YANTRI_AGENT_PORT=8765

# Override the agent's base URL. NOTE: the variable name is DESKTOP_AGENT_URL
# (not YANTRI_AGENT_URL — that name does nothing).
# DESKTOP_AGENT_URL=http://127.0.0.1:8765

# Path to a PyInstaller-frozen agent executable (packaged desktop app).
# YANTRI_AGENT_EXE=/Applications/Yantri.app/Contents/MacOS/Yantri-agent

# Interpreter used to auto-spawn the agent. Must have fastapi + uvicorn
# installed. Leave blank — the server prefers the project .venv, then
# python3, then python.
# YANTRI_PYTHON=/usr/bin/python3

# Browser automation mode for the agent:
#   managed = agent launches its own Playwright Chromium (default, works headless)
#   cdp     = attach to your existing Chrome via DevTools Protocol
#              (in cdp mode also set YANTRI_CDP_URL below, and start Chrome with
#               --remote-debugging-port=9222)
YANTRI_BROWSER_MODE=managed
# YANTRI_CDP_URL=http://127.0.0.1:9222

# Where the Python agent writes its logs. Defaults to the server's data dir.
# YANTRI_DATA_DIR=

# Disable Vite HMR / file watching. Set true when the UI flickers during edits
# or on a constrained host.
# DISABLE_HMR=false


# ───────────────────────────────────────────────────────────────────────────
# 6. OS-provided — detected automatically, do NOT normally set these
# ───────────────────────────────────────────────────────────────────────────
# The agent reads these from the environment; your OS already provides them.
# Listed for completeness in case you run in a stripped container.
#
# Tesseract OCR binary (Linux). Needed only for screenshot text extraction.
#   macOS:   brew install tesseract
#   apt:     sudo apt install tesseract-ocr
# TESSERACT_PATH=/usr/bin/tesseract
#
# Wayland display socket — required for screenshots on Wayland/Linux.
# WAYLAND_DISPLAY=wayland-0
#
# Desktop-environment hints used to pick the Linux backend.
# XDG_CURRENT_DESKTOP=GNOME
#
# Windows-only paths, injected by Windows itself.
# LOCALAPPDATA=C:\Users\<you>\AppData\Local
# PROGRAMFILES=C:\Program Files


# ───────────────────────────────────────────────────────────────────────────
# 7. Frontend build-time (Vite) — baked into the JS bundle at build
# ───────────────────────────────────────────────────────────────────────────
# These are NOT read by the Node server; Vite inlines them into the bundle, so
# changing them requires a rebuild (`npm run build`).
#
# Set only if the browser UI is served from a different origin than the API.
# Leave blank when the UI and API share an origin (the normal local case) —
# the app then falls back to window.location automatically.
# VITE_BACKEND_URL=https://your-api.example.com
#
# Origin of the OPTIONAL standalone Playwright helper (local-agent.js), which
# runs on its own port and is separate from the Python agent. Leave blank
# unless you actually started that helper.
# VITE_LOCAL_AGENT_URL=http://127.0.0.1:3001


# ───────────────────────────────────────────────────────────────────────────
# 8. Runtime files written by the app (never edit, never commit)
# ───────────────────────────────────────────────────────────────────────────
# These live in YANTRI_DATA_DIR (project root by default) and are gitignored:
#   settings.json          user preferences (voice, wake word, theme)
#   profile.json           onboarding profile (name, role, features)
#   memories.json          persistent memory store
#   reminders.json         scheduled reminders
#   userdata.json          deadlines, notes, inventory, flashcards
#   secrets.json           API key entered through the UI (chmod 600)
#   google_tokens.json     Google OAuth consent tokens
#   logs/                  commands.log, errors.log, startup.log
#
# Delete settings.json + profile.json to re-run onboarding from scratch.
# ═══════════════════════════════════════════════════════════════════════════